//WAP to find odd or even

#include<stdio.h>
#include<conio.h>

void main()
{
	int x;
	clrscr();

	printf("Enter any number: ");
	scanf("zd",&x);

	if(x%2==0)
	{
		printf("The number is even");
	}
	else
	{
		printf("The number is odd");
	}

	getch();
}
